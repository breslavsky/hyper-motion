        "fields": [
          "app/ui.stats[*][1] metric values",
          "avatar/brand initials and arrow/icon artwork",
          "chat row message bodies",
          "editor title and prose",
          "empty placeholder bars",
          "blank search field"
        ],
        "reason": "Metric values, prose and artwork are meaningful content or nontext shapes; they do not inherit compact-label truncation."
      }
    },
    "hud": {
      "file": "source/lib/components/decor.mjs",
      "scope": "all catalog types when look.deco.hud is enabled",
