        "ui-macro",
        "ui-float",
        "phones",
        "laptop",
        "browser",
        "callouts",
        "between",
        "knockout"
      ],
      "condition": "Only drawn mockUI fallback; supplied screenshots are unchanged.",
      "singleLine": [
        "brand.name sidebar label",
        "app/ui.nav[*] sidebar labels",
        "app/ui.title header",
        "app/ui.cta header action",
        "app/ui.stats[*][0] stat labels",
        "app/ui.rows[*][0] list names",
        "app/ui.rows[*][1] list/inbox details",
        "app/ui.status[*] status badges",
        "app/ui.rows[*][0] chat author metadata",
        "app/ui.stats[0][0] chart label",
        "app/ui.nav[*] phone tab labels"
      ],
