        "brand.name (uppercase HUD brand label)"
      ],
      "preserved": {
        "fields": [
          "sequence number",
          "timecode",
          "coordinates",
          "signal percentage"
        ],
        "reason": "Numeric telemetry and sequence identifiers remain complete; the brand leaf flexes within the remaining bounded row."
      }
    }
  },
