{
  "schema": "pure-kinetic.ellipsis-scope.v1",
  "rule": {
    "domHelper": "K.design.truncateLine(node)",
    "canvasHelper": "K.design.truncateCanvasLine(context, copy, maxWidth)",
    "contract": "Only bounded, semantically single-line text uses ellipsis at its unchanged typography. DOM leaves retain complete source text in textContent; an optional title must match the full text. Raster receipts retain the full source separately from painted text.",
    "preserved": "Animated hero and narrative copy, deliberate multiline messages, numeric values and genuine scrolling typing inputs keep their existing layout and timing."
  },
  "sharedHelpers": {
    "mockUI": {
      "file": "source/lib/components/ui.mjs",
